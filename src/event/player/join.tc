#!import macro/const.tcm
#!import macro/global_vars.tcm
#!import macro/session_vars.tcm

PLAYER_EVENT Join;

#!expand macro/global_vars.tcm
#!expand macro/session_vars.tcm

# Init player
line _p = default.UUID;
call p_init(line _p);

while (global g_camera_npc == NULL) {
    wait(1);
}

call p_spectate_camera;

wait(2){"Time Unit" = "Seconds"};
default:SendMessage("Start");

# Create session and attach
line _id = call g_make_session;

call s_init_device(line _id);
call s_meta_attach(line _id, line _p);

call s_prg_rom_accuracy(line _id);

call s_prg_run(line _id);

call s_runner_send_chr(line _id);

# Send meta to set up mirroring on the client
loc:SetCoordinate(global g_data_location, C_PAR_OPCODE_META){"Coordinate" = "Y"};
call s_par_meta(line _id);
default:DisplayParticleEffect(global g_data_particle, global g_data_location);

# Run tests
# global VAR_S_TEST_ID = 7;

# call s_test_pre_begin(line _id);
# call ("s_test_%var(%var(_id)_test_id)")(line _id);
# call s_test_begin(line _id);
