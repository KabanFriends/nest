#!import macro/session_vars.tcm

call s_bus_tick(line _id, 1);

line jumpTo = call s_bus_mem_read(line _id, global VAR_S_CPU_REG_PC);

if (line jumpTo >= 0b10000000) {
    line jumpTo -= 256; # convert to signed value
}

global VAR_S_CPU_REG_PC += 1;
global VAR_S_CPU_REG_PC = global VAR_S_CPU_REG_PC & 0xFFFF;

line jumpTo += global VAR_S_CPU_REG_PC;
line jumpTo = line jumpTo & 0xFFFF;

if (global VAR_S_CPU_REG_PC & 0xFF00 != line jumpTo & 0xFF) {
    call s_bus_tick(line _id, 1);
}

global VAR_S_CPU_REG_PC = line jumpTo;
