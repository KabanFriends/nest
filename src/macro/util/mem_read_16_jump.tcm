# Inline Function: mem_read_16
# in = addr: address to read from
# modifies the program counter to the read address

#!import macro/session_vars.tcm

line addr: num;

line lo = call s_bus_mem_read(line _id, global VAR_S_CPU_REG_PC);
global VAR_S_CPU_REG_PC += 1;
global VAR_S_CPU_REG_PC = global VAR_S_CPU_REG_PC & 0xFFFF;
global VAR_S_CPU_REG_PC = call s_bus_mem_read(line _id, global VAR_S_CPU_REG_PC);
global VAR_S_CPU_REG_PC = global VAR_S_CPU_REG_PC << 8;
global VAR_S_CPU_REG_PC = global VAR_S_CPU_REG_PC | line lo;
