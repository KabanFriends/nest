#!import macro/enum/joy.tcm
#!import macro/const.tcm
#!import macro/player_vars.tcm
#!import macro/session_vars.tcm

FUNCTION p_runner_loop;
PARAM _p: var;

#!expand macro/player_vars.tcm

default:SetHotbarSlot(1);
default:Teleport(global g_runner_location);

if (global VAR_P_META_ATTACHED != C_ATTACHED_NONE) {
    line _id = global VAR_P_META_ATTACHED;
    if (default?IsMovementKeyPressed(){"Forward (W)" = "Pressed"}) {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_UP] = TRUE;
    } else {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_UP] = FALSE;
    }
    if (default?IsMovementKeyPressed(){"Backward (S)" = "Pressed"}) {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_DOWN] = TRUE;
    } else {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_DOWN] = FALSE;
    }
    if (default?IsMovementKeyPressed(){"Left (A)" = "Pressed"}) {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_LEFT] = TRUE;
    } else {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_LEFT] = FALSE;
    }
    if (default?IsMovementKeyPressed(){"Right (D)" = "Pressed"}) {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_RIGHT] = TRUE;
    } else {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_RIGHT] = FALSE;
    }
    if (default?IsMovementKeyPressed(){"Jump (Space)" = "Pressed"}) {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_A] = TRUE;
    } else {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_A] = FALSE;
    }
    if (default?IsMovementKeyPressed(){"Sneak (Left Shift)" = "Pressed"}) {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_B] = TRUE;
    } else {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_B] = FALSE;
    }

    if (global VAR_P_JOY_BUFFER_SELECT > 0) {
        global VAR_P_JOY_BUFFER_SELECT -= 1;
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_SELECT] = TRUE;
    } else {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_SELECT] = FALSE;
    }

    if (global VAR_P_JOY_BUFFER_START > 0) {
        global VAR_P_JOY_BUFFER_START -= 1;
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_START] = TRUE;
    } else {
        global VAR_S_JOY_STATE_1[E_JOY_BUTTON_START] = FALSE;
    }
}
