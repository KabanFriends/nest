#!import macro/const.tcm

FUNCTION p_runner_send_chr;
PARAM _id: var;

line index = 0;
repeat (C_PPU_CHR_COUNT) {
    loc:SetCoordinate(global g_data_location, C_PAR_OPCODE_CHR){"Coordinate" = "Y"};
    line part = 0;
    repeat (16) {
        call s_par_chr(line _id, line index, line part);
        default:DisplayParticleEffect(global g_data_particle, global g_data_location);
        line part += 1;
    }
    line index += 1;
}
