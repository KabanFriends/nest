#!import macro/session_vars.tcm
#!import macro/enum/joy.tcm
#!import macro/const.tcm

FUNCTION s_joy_read_1;
PARAM _id: var;
RETURNS num;

#!expand macro/session_vars.tcm

if (global VAR_S_JOY_INDEX_1 > E_JOY_BUTTON_RIGHT) {
    return TRUE;
}

line ret = global VAR_S_JOY_STATE_1[global VAR_S_JOY_INDEX_1];
if (global VAR_S_JOY_STROBE == FALSE) {
    global VAR_S_JOY_INDEX_1 += 1;
}
return line ret;
