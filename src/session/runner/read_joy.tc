#!import macro/enum/joy.tcm
#!import macro/session_vars.tcm
#!import macro/player_vars.tcm
#!import macro/const.tcm

FUNCTION s_runner_read_joy;
PARAM _id: var;

#!expand macro/session_vars.tcm
#!expand macro/player_vars.tcm

#!expand macro/select_attached.tcm

line _p = global VAR_S_META_ATTACHED;

if (selected?IsMovementKeyPressed(){"Forward (W)" = "Pressed"}) {
    global VAR_S_RUNNER_BUFFER_JOY_1[E_JOY_BUTTON_UP] = TRUE;
}
if (selected?IsMovementKeyPressed(){"Backward (S)" = "Pressed"}) {
    global VAR_S_RUNNER_BUFFER_JOY_1[E_JOY_BUTTON_DOWN] = TRUE;
}
if (selected?IsMovementKeyPressed(){"Left (A)" = "Pressed"}) {
    global VAR_S_RUNNER_BUFFER_JOY_1[E_JOY_BUTTON_LEFT] = TRUE;
}
if (selected?IsMovementKeyPressed(){"Right (D)" = "Pressed"}) {
    global VAR_S_RUNNER_BUFFER_JOY_1[E_JOY_BUTTON_RIGHT] = TRUE;
}
if (selected?IsMovementKeyPressed(){"Jump (Space)" = "Pressed"}) {
    global VAR_S_RUNNER_BUFFER_JOY_1[E_JOY_BUTTON_A] = TRUE;
}
if (selected?IsMovementKeyPressed(){"Sneak (Left Shift)" = "Pressed"}) {
    global VAR_S_RUNNER_BUFFER_JOY_1[E_JOY_BUTTON_B] = TRUE;
}
