#!import macro/session_vars.tcm
#!import macro/const.tcm

FUNCTION s_runner_init;
PARAM _id: var;

#!expand macro/session_vars.tcm

global VAR_S_RUNNER_BUFFER_JOY_1 = [];
global VAR_S_RUNNER_BUFFER_JOY_2 = [];
repeat (line index to 8) {
    list:Append(global VAR_S_RUNNER_BUFFER_JOY_1, FALSE);
    list:Append(global VAR_S_RUNNER_BUFFER_JOY_2, FALSE);
}

# TODO: META_ATTACHED should be in here too
global VAR_S_RUNNER_FRAMECOUNTER_TICKS = 0;
global VAR_S_RUNNER_FRAMECOUNTER_DRAWS = 0;
global VAR_S_RUNNER_LAST_OAM = [];
global VAR_S_RUNNER_BUFFER_VRAM = [];
global VAR_S_RUNNER_BUFFER_DIRTY_VRAM = {};
global VAR_S_RUNNER_BUFFER_OAM = [];
global VAR_S_RUNNER_BUFFER_DIRTY_SPR = {};
global VAR_S_RUNNER_BUFFER_CTRL = 0;
global VAR_S_RUNNER_BUFFER_META_DIRTY = FALSE;
global VAR_S_RUNNER_BUFFER_SCRL_X = 0;
global VAR_S_RUNNER_BUFFER_SCRL_Y = 0;
global VAR_S_RUNNER_BUFFER_SCRL_DIRTY = FALSE;
global VAR_S_RUNNER_BUFFER_PALETTE_TABLE = [];
global VAR_S_RUNNER_BUFFER_PALETTE_DIRTY = {};
global VAR_S_RUNNER_BUFFER_BACKDROP_DIRTY = FALSE;
