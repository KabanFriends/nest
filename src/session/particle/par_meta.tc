#!import macro/enum/ppu.tcm
#!import macro/session_vars.tcm

FUNCTION s_par_meta;
PARAM _id: var;

#!expand macro/session_vars.tcm

line c_mirror = global VAR_S_PPU_MIRRORING << 22;
line c_nmIndex = (global VAR_S_RUNNER_BUFFER_CTRL & 0b00011000) << 17;
line c_sprMode = (global VAR_S_RUNNER_BUFFER_CTRL & E_PPU_CTRL_FLAG_SPR_SIZE) << 15;

line color = line c_mirror + line c_nmIndex + line c_sprMode;

#!expand macro/make_particle.tcm
