#!import macro/enum/ppu.tcm
#!import macro/session_vars.tcm
#!import macro/global_vars.tcm
#!import macro/const.tcm

FUNCTION s_ppu_init;
PARAM _id: var;

#!expand macro/session_vars.tcm
#!expand macro/global_vars.tcm

global VAR_S_PPU_CHR = [];
repeat (C_PPU_CHR_SIZE) {
    list:Append(global VAR_S_PPU_CHR, 0);
}

global VAR_S_PPU_VRAM = [];
repeat (C_PPU_VRAM_SIZE) {
    list:Append(global VAR_S_PPU_VRAM, 0);
}

global VAR_S_PPU_PALETTE_TABLE = [];
repeat (C_PPU_PALETTE_SIZE) {
    list:Append(global VAR_S_PPU_PALETTE_TABLE, 0);
}

global VAR_S_PPU_OAM_DATA = [];
repeat (C_PPU_OAM_SIZE) {
    list:Append(global VAR_S_PPU_OAM_DATA, 0);
}

global VAR_S_PPU_CYCLES = 0;
global VAR_S_PPU_SCANLINE = 0;
global VAR_S_PPU_OAM_ADDR = 0;
global VAR_S_PPU_REG_ADDR = 0;
global VAR_S_PPU_REG_DATA = 0;
global VAR_S_PPU_REG_CTRL = 0;
global VAR_S_PPU_REG_MASK = 0;
global VAR_S_PPU_REG_SCRL_X = 0;
global VAR_S_PPU_REG_SCRL_Y = 0;
global VAR_S_PPU_REG_STATUS = C_PPU_STATUS_RESET;
global VAR_S_PPU_ADDR_LATCH = TRUE;
global VAR_S_PPU_SCRL_LATCH = TRUE;
global VAR_S_PPU_MIRRORING = E_PPU_MIRRORING_VERTICAL;

# Fill the variable once to pre-expand its underlying Java HashMap capacity
global VAR_S_PPU_DIRTY_VRAM = {};
repeat (line num to C_PPU_VRAM_SIZE) {
    global VAR_S_PPU_DIRTY_VRAM[global g_num_to_str[line num]] = -1;
}
dict:Clear(global VAR_S_PPU_DIRTY_VRAM);
