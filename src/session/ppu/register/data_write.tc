#!import macro/enum/ppu.tcm
#!import macro/const.tcm
#!import macro/session_vars.tcm
#!import macro/global_vars.tcm

FUNCTION s_ppu_data_write;
PARAM _id: var;
PARAM value: var;

line value: num;

#!expand macro/session_vars.tcm
#!expand macro/global_vars.tcm

#!define    ADDR    global VAR_S_PPU_REG_ADDR

# increment addr register address
line addr = ADDR;
if (global VAR_S_PPU_REG_CTRL & E_PPU_CTRL_FLAG_VRAM_ADDR_INCREMENT > 0) {
    ADDR += 32;
} else {
    ADDR += 1;
}
ADDR = ADDR & 0x3FFF;

if (var?IsInRange(line addr, C_PPU_MEM_VRAM_START, C_PPU_MEM_VRAM_END)) {
#!expand macro/ppu/mirror_vram_address.tcm
    line addr_out += 1;
    if (global VAR_S_PPU_VRAM[line addr_out] != line value) {
        global VAR_S_PPU_DIRTY_VRAM[global g_num_to_str[line addr_out]] = line addr_out;
    }
    global VAR_S_PPU_VRAM[line addr_out] = line value;
    return;
}
if (var?IsInRange(line addr, C_PPU_MEM_PALETTE_START, C_PPU_MEM_PALETTE_END)) {
    line addr = line addr & 0x1F;
    
    # Set a special dirty flag for the backdrop color change
    if (line addr == 0x00) {
        global VAR_S_PPU_BACKDROP_DIRTY = TRUE;
    } else {
        # Index 0 of each palette is not drawn so doesn't need to be sent to the client
        if (line addr % 4 != 0) {
            line paletteIndex = num:Round(line addr / 4){"Round Mode" = "Ceiling"};
            line paletteIndex += 1;
            global VAR_S_PPU_PALETTE_DIRTY[global g_num_to_str[line paletteIndex]] = line paletteIndex;
        }
    }

    line addr += 1;
    global VAR_S_PPU_PALETTE_TABLE[line addr] = line value;
    return;
}

call s_log_error(line _id, s"PPU data write to unsupported address: " + call u_num_to_radix(line addr, 4) + " (PC=" + call u_num_to_radix(global VAR_S_CPU_REG_PC, 4) + ")");
