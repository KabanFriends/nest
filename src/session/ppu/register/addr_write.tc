#!import macro/const.tcm
#!import macro/session_vars.tcm

FUNCTION s_ppu_addr_write;
PARAM _id: var;
PARAM value: var;

line value: num;

#!expand macro/session_vars.tcm

if (global VAR_S_PPU_ADDR_LATCH == TRUE) {
    global VAR_S_PPU_REG_ADDR = line value << 8;
    global VAR_S_PPU_ADDR_LATCH = FALSE;
} else {
    global VAR_S_PPU_REG_ADDR = global VAR_S_PPU_REG_ADDR | line value;
    global VAR_S_PPU_ADDR_LATCH = TRUE;
}
global VAR_S_PPU_REG_ADDR = global VAR_S_PPU_REG_ADDR & 0x3FFF;
