#!import macro/enum/ppu.tcm
#!import macro/const.tcm
#!import macro/session_vars.tcm

FUNCTION s_ppu_data_read;
PARAM _id: var;
RETURNS num;

#!expand macro/session_vars.tcm

#!define    ADDR    global VAR_S_PPU_REG_ADDR

# increment addr register address
line addr = ADDR;
if (global VAR_S_PPU_REG_CTRL & E_PPU_CTRL_FLAG_VRAM_ADDR_INCREMENT > 0) {
    ADDR += 32;
} else {
    ADDR += 1;
}
ADDR = ADDR & 0x3FFF;

if (line addr <= C_PPU_MEM_CHR_END) {
    line addr += 1;
    line ret = global VAR_S_PPU_DATA_BUFFER;
    global VAR_S_PPU_DATA_BUFFER = global VAR_S_PPU_CHR[line addr];
    return line ret;
}
if (line addr <= C_PPU_MEM_VRAM_END) {
#!expand macro/ppu/mirror_vram_address.tcm
    line addr_out += 1;
    line ret = global VAR_S_PPU_DATA_BUFFER;
    global VAR_S_PPU_DATA_BUFFER = global VAR_S_PPU_VRAM[line addr_out];
    return line ret;
}
if (line addr <= C_PPU_MEM_PALETTE_END) {
    line addr = line addr & 0x1F;
    line addr += 1;
    return global VAR_S_PPU_PALETTE_TABLE[line addr];
}

call s_log_error(line _id, s"PPU data read from unsupported address: " + call u_num_to_radix(line addr, 4) + " (PC=" + call u_num_to_radix(global VAR_S_CPU_REG_PC, 4) + ")");
return 0;
