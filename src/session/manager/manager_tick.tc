#!import macro/enum/debug.tcm
#!import macro/enum/manager.tcm
#!import macro/enum/cpu.tcm
#!import macro/const.tcm
#!import macro/session_vars.tcm

FUNCTION s_manager_tick;
PARAM _id: var;

#!expand macro/global_vars.tcm
#!expand macro/session_vars.tcm

if (global VAR_S_MANAGER_STATE != E_MANAGER_STATE_RUNNING) {
    return;
}

call s_cpu_tick(line _id);

# If CPU encountered an error, stop the emulation and run test checks
if (global VAR_S_CPU_ERROR_STATE != E_CPU_ERROR_STATE_NONE) {
    global VAR_S_MANAGER_STATE = E_MANAGER_STATE_IDLE;
    if (global VAR_S_TEST_ID > 0) {
        call ("s_test_verify_%var(%var(_id)_test_id)")(line result, line _id);
        call s_test_result(line _id, line result);
    }
}

# If CPU step is ON, pause the emulation
if (global VAR_S_DEBUG_STEP_MODE == E_DEBUG_STEP_MODE_CPU) {
    global VAR_S_MANAGER_STATE = E_MANAGER_STATE_PAUSE;
    call s_log_debug_high(line _id, s"CPU stepped - <white><click:run_command:@inspect cpu>Click to open inspector</click></white>");
    line funcName: str = global g_opcode_func_names[global VAR_S_CPU_CODE + 1];
    line code = call u_num_to_radix(global VAR_S_CPU_CODE);
    call s_log_debug_high(line _id, s"Executed: <white>%var(funcName) | %var(code)</white>");
}
