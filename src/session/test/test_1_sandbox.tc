#!import macro/session_vars.tcm

FUNCTION s_test_1;
PARAM _id: var;

#!expand macro/session_vars.tcm

global VAR_S_TEST_NAME = "Sandbox";

line cpuData = [
    0xE9, 0x01, # SBC #$01
    0x00,       # BRK
];
line cpuAddress = 0x200;

for (line value in line cpuData) {
    global VAR_S_RAM[line cpuAddress + 1] = line value;
    line cpuAddress += 1;
}
