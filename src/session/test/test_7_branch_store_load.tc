#!import macro/session_vars.tcm

FUNCTION s_test_7;
PARAM _id: var;

#!expand macro/session_vars.tcm

global VAR_S_TEST_NAME = "Stores, Loads, Branches";

line cpuData = [
    0xA9, 0x07, # LDA #$07
    0x85, 0x10, # STA $10
    0xA2, 0x00, # LDX #$00

    # Loop: increment RAM[$10] three times
    0xA5, 0x10, # LDA $10
    0x18,       # CLC
    0x69, 0x01, # ADC #$01
    0x85, 0x10, # STA $10
    0xE8,       # INX
    0xE0, 0x03, # CPX #$03
    0xD0, 0xF4, # BNE back to LDA $10

    # Verify a taken branch path (BEQ)
    0xA9, 0x00, # LDA #$00
    0xF0, 0x02, # BEQ skip next LDA
    0xA9, 0xFF, # LDA #$FF (must be skipped)

    0xA5, 0x10, # LDA $10
    0x00        # BRK
];
line cpuAddress = 0x200;

for (line value in line cpuData) {
    global VAR_S_RAM[line cpuAddress + 1] = line value;
    line cpuAddress += 1;
}
