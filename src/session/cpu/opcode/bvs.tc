#!import macro/enum/cpu.tcm
#!import macro/session_vars.tcm

FUNCTION s_cpu_op_bvs;
PARAM _id: var;
PARAM addr_mode: var;

#!expand macro/session_vars.tcm

# Logic flow:
# 1. Check the branching condition
# 2. Suspend the CPU to tick bus once
# 3. After returning from the suspended state, jump to the target address
# 4. Suspend again (optional if page cross happens)

# flow 1
if (global VAR_S_MANAGER_CPU_SUSPEND == 0) {
    line overflow = global VAR_S_CPU_REG_P & E_CPU_FLAG_OVERFLOW;
    if (line overflow == 0) {
        return;
    }

    global VAR_S_MANAGER_CPU_SUSPEND = 1;
    global VAR_S_MANAGER_BUS_TICKS_LEFT += 1;
    return;
}

#!expand macro/branch_flow.tcm
