#!import macro/enum/cpu.tcm
#!import macro/const.tcm
#!import macro/session_vars.tcm

FUNCTION s_cpu_op_plp;
PARAM _id: var;
PARAM addr_mode: var;

#!expand macro/session_vars.tcm

global VAR_S_CPU_REG_SP += 1;
global VAR_S_CPU_REG_SP = global VAR_S_CPU_REG_SP & 0xFF;
line addr = C_CPU_STACK + global VAR_S_CPU_REG_SP;
global VAR_S_CPU_REG_P = call s_bus_mem_read(line _id, line addr);

global VAR_S_CPU_REG_P = global VAR_S_CPU_REG_P & ~E_CPU_FLAG_BREAK;
global VAR_S_CPU_REG_P = global VAR_S_CPU_REG_P | E_CPU_FLAG_BREAK2;
