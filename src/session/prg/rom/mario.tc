#!import macro/enum/ppu.tcm
#!import macro/rom/mario.tcm

FUNCTION s_prg_rom_mario;
PARAM _id: var;

line prg = [
    "ROM_PRG0",
    "ROM_PRG1",
    "ROM_PRG2",
    "ROM_PRG3",
    "ROM_PRG4",
    "ROM_PRG5",
    "ROM_PRG6",
    "ROM_PRG7"
];

line chr = [
    "ROM_CHR0",
    "ROM_CHR1"
];

call s_prg_rom_load(
    line _id,
    E_PPU_MIRRORING_VERTICAL,
    line prg,
    line chr
);
