#!import macro/session_vars.tcm
#!import macro/const.tcm

FUNCTION s_prg_init;
PARAM _id: var;

#!expand macro/session_vars.tcm

global VAR_S_PRG0 = [];
global VAR_S_PRG1 = [];
global VAR_S_PRG2 = [];
global VAR_S_PRG3 = [];

repeat (C_ROM_PRG_PART_SIZE) {
    list:Append(global VAR_S_PRG0, 0);
    list:Append(global VAR_S_PRG1, 0);
    list:Append(global VAR_S_PRG2, 0);
    list:Append(global VAR_S_PRG3, 0);
}
