#!import macro/session_vars.tcm
#!import macro/const.tcm

FUNCTION s_bus_tick;
PARAM _id: var;
PARAM cycles: num;

#!expand macro/session_vars.tcm

line nmiBefore = global VAR_S_BUS_NMI;

call s_ppu_tick(line _id, line cycles * C_PPU_CYCLES_PER_CPU);

if (line nmiBefore == FALSE) {
    if (global VAR_S_BUS_NMI == TRUE) {
        global VAR_S_RUNNER_FRAMECOUNTER_DRAWS += 1;

        # Read joypad states for the next frame
        global VAR_S_JOY_STATE_1 = global VAR_S_RUNNER_BUFFER_JOY_1;
        global VAR_S_JOY_STATE_2 = global VAR_S_RUNNER_BUFFER_JOY_2;

        # Move the data of this frame to the buffer
        # Store the PPU CTRL register
        global VAR_S_RUNNER_BUFFER_CTRL = global VAR_S_PPU_REG_CTRL;
        global VAR_S_RUNNER_BUFFER_META_DIRTY = global VAR_S_PPU_META_DIRTY | global VAR_S_RUNNER_BUFFER_META_DIRTY;
        global VAR_S_PPU_META_DIRTY = FALSE;

        # Store the PPU SCRL register
        global VAR_S_RUNNER_BUFFER_SCRL_X = global VAR_S_PPU_REG_SCRL_X;
        global VAR_S_RUNNER_BUFFER_SCRL_Y = global VAR_S_PPU_REG_SCRL_Y;
        global VAR_S_RUNNER_BUFFER_SCRL_DIRTY = global VAR_S_PPU_SCRL_DIRTY | global VAR_S_RUNNER_BUFFER_SCRL_DIRTY;
        global VAR_S_PPU_SCRL_DIRTY = FALSE;

        # Write the frame data to the buffer
        global VAR_S_RUNNER_BUFFER_VRAM = global VAR_S_PPU_VRAM;
        global VAR_S_RUNNER_BUFFER_OAM = global VAR_S_PPU_OAM_DATA;

        # Copy dirty VRAM and OAM addresses
        dict:Append(global VAR_S_RUNNER_BUFFER_DIRTY_VRAM, global VAR_S_PPU_DIRTY_VRAM);
        dict:Append(global VAR_S_RUNNER_BUFFER_DIRTY_SPR, global VAR_S_PPU_DIRTY_SPR);
        dict:Clear(global VAR_S_PPU_DIRTY_VRAM);
        dict:Clear(global VAR_S_PPU_DIRTY_SPR);
    }
}
