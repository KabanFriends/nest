#!import macro/const.tcm
#!import macro/session_vars.tcm

FUNCTION s_ram_init;
PARAM _id: var;

#!expand macro/session_vars.tcm

global VAR_S_RAM = [];

line addr = 0;
repeat (C_RAM_SIZE) {
    line eight = line addr % 8;
    if (line eight >= 4) {
        list:Append(global VAR_S_RAM, 0xFF);
    } else {
        list:Append(global VAR_S_RAM, 0x00);
    }
    line addr += 1;
}
