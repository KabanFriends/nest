call g_opcode_add(0xED, "s_cpu_op_sbc", 3, 4, E_CPU_ADDR_MODE_ABSOLUTE);
call g_opcode_add(0xFD, "s_cpu_op_sbc", 3, 4, E_CPU_ADDR_MODE_ABSOLUTE_X);
call g_opcode_add(0xF9, "s_cpu_op_sbc", 3, 4, E_CPU_ADDR_MODE_ABSOLUTE_Y);
call g_opcode_add(0xE1, "s_cpu_op_sbc", 2, 6, E_CPU_ADDR_MODE_INDIRECT_X);
call g_opcode_add(0xF1, "s_cpu_op_sbc", 2, 5, E_CPU_ADDR_MODE_INDIRECT_Y);

call g_opcode_add(0x29, "s_cpu_op_and", 2, 2, E_CPU_ADDR_MODE_IMMEDIATE);
call g_opcode_add(0x25, "s_cpu_op_and", 2, 3, E_CPU_ADDR_MODE_ZERO_PAGE);
