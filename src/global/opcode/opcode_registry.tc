call g_opcode_add(0x51, "s_cpu_op_eor", 2, 5, E_CPU_ADDR_MODE_INDIRECT_Y);

call g_opcode_add(0x09, "s_cpu_op_ora", 2, 2, E_CPU_ADDR_MODE_IMMEDIATE);
call g_opcode_add(0x05, "s_cpu_op_ora", 2, 3, E_CPU_ADDR_MODE_ZERO_PAGE);
