call g_opcode_add(0x2D, "s_cpu_op_and", 3, 4, E_CPU_ADDR_MODE_ABSOLUTE);
call g_opcode_add(0x3D, "s_cpu_op_and", 3, 4, E_CPU_ADDR_MODE_ABSOLUTE_X);
