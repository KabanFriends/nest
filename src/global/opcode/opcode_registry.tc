#!import macro/enum/cpu.tcm

FUNCTION g_opcode_registry;

#!expand macro/global_vars.tcm

# Initialize opcode registry
global g_opcode_func_names = [];
global g_opcode_lengths = [];
global g_opcode_cycles = [];
global g_opcode_addr_modes = [];

repeat (0x100) {
    list:Append(global g_opcode_func_names, "s_cpu_op_invalid");
    list:Append(global g_opcode_lengths, 0);
    list:Append(global g_opcode_cycles, 0);
    list:Append(global g_opcode_addr_modes, E_CPU_ADDR_MODE_NONE);
}

# Register opcodes
# 0. special
call g_opcode_add(0x00, "s_cpu_op_brk", 1, 7, E_CPU_ADDR_MODE_NONE);
call g_opcode_add(0xEA, "s_cpu_op_nop", 1, 2, E_CPU_ADDR_MODE_NONE);

# 1. arithmetic
call g_opcode_add(0x69, "s_cpu_op_adc", 2, 2, E_CPU_ADDR_MODE_IMMEDIATE);
call g_opcode_add(0x65, "s_cpu_op_adc", 2, 3, E_CPU_ADDR_MODE_ZERO_PAGE);
call g_opcode_add(0x75, "s_cpu_op_adc", 2, 4, E_CPU_ADDR_MODE_ZERO_PAGE_X);
call g_opcode_add(0x6D, "s_cpu_op_adc", 3, 4, E_CPU_ADDR_MODE_ABSOLUTE);
call g_opcode_add(0x7D, "s_cpu_op_adc", 3, 4, E_CPU_ADDR_MODE_ABSOLUTE_X);
call g_opcode_add(0x79, "s_cpu_op_adc", 3, 4, E_CPU_ADDR_MODE_ABSOLUTE_Y);
call g_opcode_add(0x61, "s_cpu_op_adc", 2, 6, E_CPU_ADDR_MODE_INDIRECT_X);
call g_opcode_add(0x71, "s_cpu_op_adc", 2, 5, E_CPU_ADDR_MODE_INDIRECT_Y);

call g_opcode_add(0xE9, "s_cpu_op_sbc", 2, 2, E_CPU_ADDR_MODE_IMMEDIATE);
